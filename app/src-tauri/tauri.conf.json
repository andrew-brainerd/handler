{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Handler",
  "version": "0.1.0",
  "identifier": "dev.brainerd.handler",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../relay/": "relay/",
      "../../hook/handler-hook.mjs": "hook/handler-hook.mjs",
      "../../scripts/hooks.mjs": "scripts/hooks.mjs",
      "../../characters/": "characters/"
    }
  }
}
